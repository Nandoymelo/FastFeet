generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DELIVERYMAN
}

model User {
  id           String   @id @default(uuid())
  cpf          String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole

  @@map("users")
}
